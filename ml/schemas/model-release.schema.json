{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardlens.local/schemas/model-release.schema.json",
  "title": "CardLens offline model release",
  "type": "object",
  "required": ["schema_version", "model_version", "dataset_version", "created_at", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "model_version": {"type": "string", "minLength": 1},
    "dataset_version": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "source_revision": {"type": ["string", "null"]},
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "file", "sha256", "bytes"],
        "properties": {
          "name": {"type": "string"},
          "file": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}

