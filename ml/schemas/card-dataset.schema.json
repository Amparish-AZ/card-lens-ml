{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cardlens.local/schemas/card-dataset.schema.json",
  "title": "CardLens card annotation",
  "type": "object",
  "required": ["schema_version", "card_id", "image", "split", "lines"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "card_id": {"type": "string", "minLength": 1},
    "image": {"type": "string", "minLength": 1},
    "split": {"enum": ["train", "validation", "test"]},
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ocr_text", "truth_text", "label", "box"],
        "additionalProperties": false,
        "properties": {
          "ocr_text": {"type": "string"},
          "truth_text": {"type": "string", "minLength": 1},
          "label": {
            "enum": ["name", "title", "company", "email", "phone", "website", "address", "other"]
          },
          "box": {
            "description": "Normalized x, y, width, height values in the range 0..1.",
            "type": "array",
            "prefixItems": [
              {"type": "number", "minimum": 0, "maximum": 1},
              {"type": "number", "minimum": 0, "maximum": 1},
              {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
              {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
            ],
            "minItems": 4,
            "maxItems": 4
          }
        }
      }
    }
  }
}

