{
  "project": "cardlens",
  "dataset_schema_version": 1,
  "model_release_schema_version": 1,
  "runtime": {
    "inference": "offline",
    "android_ocr": "onnxruntime",
    "parser": "tflite"
  },
  "artifacts": {
    "ocr_detector": "android/ppocr-sdk/src/main/assets/models/det/inference.onnx",
    "ocr_recognizer": "android/ppocr-sdk/src/main/assets/models/rec/inference.onnx",
    "ocr_recognizer_config": "android/ppocr-sdk/src/main/assets/models/rec/inference.yml",
    "field_parser": "assets/models/card_field_classifier.tflite",
    "parser_metrics": "assets/models/training_metrics.json"
  },
  "quality_gates": {
    "ocr.character_error_rate": {"operator": "max", "value": 0.12},
    "ocr.exact_email_accuracy": {"operator": "min", "value": 0.95},
    "ocr.exact_phone_accuracy": {"operator": "min", "value": 0.95},
    "parser.name_f1": {"operator": "min", "value": 0.85},
    "parser.company_f1": {"operator": "min", "value": 0.85},
    "runtime.android_p95_ms": {"operator": "max", "value": 12000}
  }
}

